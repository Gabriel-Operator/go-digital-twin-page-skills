{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persona ontology v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceKey",
    "version",
    "name",
    "status",
    "entities",
    "relationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resourceKey": {
      "type": "string",
      "pattern": "^ontology\\.persona\\.[a-z0-9][a-z0-9.-]{0,100}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "placeholder",
        "defined"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "entities": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attributes"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "attributes": {
            "type": "object",
            "maxProperties": 200,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "integer",
                    "boolean",
                    "object",
                    "array",
                    "date",
                    "datetime"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "required": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "from",
          "to",
          "direction"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "direction": {
            "enum": [
              "directed",
              "undirected"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "cardinality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "enum": [
                  "one",
                  "many"
                ]
              },
              "to": {
                "enum": [
                  "one",
                  "many"
                ]
              },
              "minTargets": {
                "type": "integer",
                "minimum": 0
              },
              "maxTargets": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "primitives": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "Source"
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/model"
        },
        "translations": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/copy"
          }
        },
        "variants": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/variant"
          }
        },
        "sourceLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "regions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/region"
          }
        },
        "personalizations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/personalization"
          }
        }
      },
      "required": [
        "sourceLanguage",
        "regions",
        "personalizations"
      ]
    }
  },
  "$defs": {
    "term": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "entityTerm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "attributes": {
          "type": "object",
          "maxProperties": 200,
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "glossary": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "entities": {
          "type": "object",
          "maxProperties": 200,
          "additionalProperties": {
            "$ref": "#/$defs/entityTerm"
          }
        },
        "relationships": {
          "type": "object",
          "maxProperties": 400,
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "placeholder",
            "defined"
          ]
        },
        "entities": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "attributes"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "attributes": {
                "type": "object",
                "maxProperties": 200,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "object",
                        "array",
                        "date",
                        "datetime"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "nullable": {
                      "type": "boolean"
                    },
                    "enum": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 100,
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "from",
              "to",
              "direction"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "direction": {
                "enum": [
                  "directed",
                  "undirected"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "cardinality": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "enum": [
                      "one",
                      "many"
                    ]
                  },
                  "to": {
                    "enum": [
                      "one",
                      "many"
                    ]
                  },
                  "minTargets": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxTargets": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "primitives": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "Source"
          }
        }
      },
      "required": [
        "name",
        "status",
        "entities",
        "relationships"
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/model"
        }
      },
      "required": [
        "definition"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "definition": {
          "$ref": "#/$defs/model"
        },
        "translations": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/copy"
          }
        },
        "variants": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/variant"
          }
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "countryCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      },
      "required": [
        "key",
        "label",
        "countryCodes",
        "defaultLanguage"
      ]
    },
    "personalization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "definition": {
          "$ref": "#/$defs/model"
        },
        "translations": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/copy"
          }
        },
        "variants": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "$ref": "#/$defs/variant"
          }
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "regionKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "audience": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "individual"
                },
                "userIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              },
              "required": [
                "type",
                "userIds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "icp"
                },
                "all": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "questionId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "oneOf": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      }
                    },
                    "required": [
                      "questionId",
                      "oneOf"
                    ]
                  }
                }
              },
              "required": [
                "type",
                "all"
              ]
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "audience"
      ]
    }
  }
}
