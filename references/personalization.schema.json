              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "profilePicture": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(https://|/(?!/))"
            },
            "landingPage": {
              "type": "object"
            },
            "chatApp": {
              "type": "object"
            },
            "chatEmbedConfig": {
              "type": "object",
