          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "regeneration": {
              "enum": [
                "auto",
                "manual"
              ]
            },
            "sections": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-zA-Z][\\w.-]*$"
              }
            }
          }
        }
      }
